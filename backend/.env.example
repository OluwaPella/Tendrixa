# Application
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32

# Database (SQLite for local; switch to Postgres for production)
DATABASE_URL=sqlite+aiosqlite:///./tendrixa.db
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/tendrixa

# CORS (frontend origin)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI provider (optional — template generator is used when empty)
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=gpt-4o-mini

# Buffer developer application (fill after you create the app)
# Do not commit real values.
BUFFER_CLIENT_ID=
BUFFER_CLIENT_SECRET=
BUFFER_REDIRECT_URI=http://localhost:8000/api/v1/buffer/callback
BUFFER_API_BASE_URL=https://api.bufferapp.com
# TODO(BUFFER): Confirm BUFFER_API_BASE_URL and OAuth endpoints
# against the official Buffer developer documentation.
